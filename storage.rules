rules_version = '2';

// Firebase Storage Security Rules for 封神 (Fujin) App
// Phase 1.1: 認証済みユーザーのみアクセス可能

service firebase.storage {
  match /b/{bucket}/o {

    // boxes配下のファイル
    // 認証済みユーザーのみ読み書き可能
    // （箱の所有者チェックは Firestore 側で担保）
    match /boxes/{boxId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // その他のパスへのアクセスは拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
